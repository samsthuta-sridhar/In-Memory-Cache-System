<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox alignment="CENTER" spacing="20"
      xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.imcs.presentation.LoginController"
      stylesheets="@../styles/application.css"
      style="-fx-background-color: #f5f5f5;">
    <padding><Insets top="60" right="100" bottom="60" left="100"/></padding>

    <Label text="In-Memory Cache System" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #37474F;"/>
    <Label text="Banking Administration Portal" style="-fx-font-size: 13px; -fx-text-fill: #888888;"/>

    <VBox spacing="14" style="-fx-background-color: white; -fx-padding: 30; -fx-background-radius: 10; -fx-border-color: #e0e0e0; -fx-border-radius: 10;" maxWidth="400">

        <Label text="Username" style="-fx-font-weight: bold; -fx-text-fill: #555;"/>
        <TextField fx:id="usernameField" promptText="Enter username"/>

        <Label text="Password" style="-fx-font-weight: bold; -fx-text-fill: #555;"/>
        <PasswordField fx:id="passwordField" promptText="Enter password"/>

        <Label fx:id="errorLabel" text="" style="-fx-text-fill: #F44336; -fx-font-size: 12px;"/>

        <Button text="Login" onAction="#handleLogin" maxWidth="Infinity"
                style="-fx-background-color: #37474F; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 10; -fx-background-radius: 6; -fx-cursor: hand;"/>

        <Label fx:id="attemptsLabel" text="" style="-fx-text-fill: #FF9800; -fx-font-size: 11px;"/>
    </VBox>
</VBox>