<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox spacing="20" xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.imcs.presentation.CacheMissViewController">
    <padding><Insets top="30" right="30" bottom="30" left="30"/></padding>

    <Label text="Cache Miss/Database Fallback" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>

    <HBox spacing="10">
        <TextField fx:id="keyField" promptText="Enter key to trigger miss" HBox.hgrow="ALWAYS"/>
        <Button text="Fetch" onAction="#handleFetch" style="-fx-background-color: #2196F3; -fx-text-fill: white;"/>
    </HBox>

    <Label text="Status:" style="-fx-font-weight: bold;"/>
    <TextArea fx:id="resultArea" editable="false" prefHeight="200"
              promptText="Cache miss/DB fetch result will appear here..."/>

    <Label fx:id="statusLabel" text="" style="-fx-font-size: 14px;"/>
</VBox>