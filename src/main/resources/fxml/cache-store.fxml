<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox spacing="16" xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.imcs.presentation.CacheStoreController">
    <padding><Insets top="24" right="24" bottom="24" left="24"/></padding>

    <Label text="Store Data in Cache"
           style="-fx-font-size: 18px; -fx-font-weight: bold;"/>
    <Label text="Values are AES-encrypted before storing in cache and PostgreSQL."
           style="-fx-text-fill: #888; -fx-font-size: 12px;"/>

    <!-- Cache capacity indicator -->
    <VBox spacing="4" style="-fx-background-color: white; -fx-padding: 12;
                              -fx-background-radius: 8; -fx-border-color: #e0e0e0;
                              -fx-border-radius: 8;">
        <Label text="Cache Capacity" style="-fx-font-weight: bold; -fx-text-fill: #555;"/>
        <ProgressBar fx:id="capacityBar" maxWidth="Infinity" prefHeight="16"/>
        <Label fx:id="capacityLabel" text="Cache: 0/10 entries (0%)"/>
    </VBox>

    <HBox spacing="10">
        <TextField fx:id="keyField"
                   promptText="Key (e.g. account:2006)"
                   HBox.hgrow="ALWAYS"/>
        <TextField fx:id="valueField"
                   promptText="Value (e.g. balance:5000)"
                   HBox.hgrow="ALWAYS"/>
    </HBox>

    <Button text="Store in Cache" onAction="#handleStore"
            style="-fx-background-color: #FF9800; -fx-text-fill: white;
                   -fx-font-weight: bold; -fx-background-radius: 6;
                   -fx-padding: 10 20 10 20; -fx-cursor: hand;"/>

    <Label text="Result:" style="-fx-font-weight: bold;"/>
    <TextArea fx:id="resultArea" editable="false" prefHeight="160"
              promptText="Store result and eviction info will appear here..."/>

    <Label fx:id="statusLabel" text=""/>
</VBox>